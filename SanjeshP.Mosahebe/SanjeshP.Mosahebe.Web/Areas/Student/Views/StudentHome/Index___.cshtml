@using SanjeshP.Mosahebe.Web.Areas.Student.ViewModels
@model IEnumerable<int>

@{
    ViewData["Title"] = "فهرست فایل ها";
}

<div class="d-flex align-items-center mb-3 gap-3">
    <div>
        <select class="custom-select form-control" id="formSelect">
            <option selected disabled>انتخاب کنید...</option>
            @foreach (var id in Model)
            {
                <option value="@id">فرم @id</option>
            }
        </select>
    </div>
    <button class="btn btn-success mr-3" id="btnAdd">+ افزودن</button>
</div>


<!-- جدول نمایش رکوردهای ثبت شده -->
<div id="submissionsContainer" class="table-wrapper">
    <!-- رکوردها با Ajax لود می‌شود -->
</div>

<!-- فرم بارگذاری شده با Ajax -->
<div id="formContainer" class="mb-3"></div>



@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {

            $("#formContainer").load("/Student/StudentHome/GetFormSubmissions", function () { });
            // تابع لود جدول رکوردها
            //function loadSubmissions(formId) {
            //    $.get('@Url.Action("GetFormSubmissions", "StudentHome", new { area = "Student" })',
            //        { formId: formId },
            //        function (data) {
            //            $("#formContainer").html(data);
            //        });
            //}
        });
        $(function () {
            // دکمه افزودن: لود فرم بالای جدول
            $("#btnAdd").on("click", function () {
                var formId = $("#formSelect").val();

                if (!formId) {
                    alert("لطفاً یک فرم انتخاب کنید.");
                    return;
                }
                $("#submissionsContainer").load("/Student/StudentHome/LoadForm?formId=" + formId, function () { });
               
                //$.get('@Url.Action("LoadForm", "StudentHome", new { area = "Student" })',
                //    { formId: formId },
                //    function (data) {
                //        $("#formContainer").html(data);
                //        loadSubmissions(formId); // رکوردهای فرم انتخاب شده را نمایش بده
                //    });
            });

            // Ajax Submit فرم
            $(document).on("submit", "#formContainer form", function (e) {
                e.preventDefault();
                var $form = $(this);
                var formData = new FormData(this);

                $.ajax({
                    url: $form.attr("action"),
                    type: $form.attr("method"),
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function () {
                        $("#formContainer").html(''); // فرم پاک شود
                        iziToast.success({ title: 'موفق', message: 'فرم با موفقیت ارسال شد' });
                        var formId = $("#formSelect").val();
                        $("#formContainer").load("/Student/StudentHome/GetFormSubmissions", function () { });
                        //loadSubmissions(formId); // جدول را آپدیت کن
                    },
                    error: function () {
                        iziToast.error({ title: 'خطا', message: 'ارسال فرم موفقیت‌آمیز نبود' });
                    }
                });
            });

            

        });
    </script>
}
