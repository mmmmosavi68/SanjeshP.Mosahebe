@model SanjeshP.Mosahebe.Web.Areas.Student.ViewModels.FormSubmissionViewModel
@{
    ViewData["Title"] = "فرم ثبت اطلاعات";
}

<h2 class="mb-4">@Model.FormTitle</h2>
<form id="formSubmission" method="post" asp-action="SubmitForm" asp-controller="StudentHome" asp-area="Student" enctype="multipart/form-data">
    <input type="hidden" name="FormId" value="@Model.FormId" />

    @foreach (var field in Model.Fields)
    {
        <div class="form-group mb-4">
            <label class="fw-bold h5">@field.Label</label>
            <span class="text-secondary">(@field.Description)</span>

            @{
                var requiredAttr = field.IsRequired ? "required" : "";
                var validationAttr = !string.IsNullOrEmpty(field.ValidationPattern)
                ? $"data-validation='{field.ValidationPattern}' data-errormessage='{field.ErrorMessage}'"
                : "";
            }
            @switch (field.inputType)
            {
                case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Text:
                    <input type="text" name="@field.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr) />
                    break;
                case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Url:
                    <input type="url" inputmode="url" name="@field.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr) />
                    break;
                case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Number:
                    <input type="number" name="@field.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr) />
                    break;
                case SanjeshP.Mosahebe.Entities.StudentForm.InputType.File:
                    <input type="file" name="@field.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr) />
                    break;
                case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Checkbox:
                    <input type="checkbox" name="@field.Name" value="true" @requiredAttr @Html.Raw(validationAttr) />
                    break;
                case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Dropdown:
                    <select name="@field.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr)>
                        @if (!string.IsNullOrEmpty(field.DropdownOptions))
                        {
                            var options = field.DropdownOptions.Split('-');
                            foreach (var opt in options)
                            {
                                <option value="@opt">@opt</option>
                            }
                        }
                    </select>
                    break;
                case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Date:
                    <input type="date" name="@field.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr) />
                    break;
            }
            <span class="text-danger text-small validation-error" style="display:none"></span>
        </div>
    }

    @* Coefficient Fields *@
    @if (Model.CoefficientFields != null)
    {
        foreach (var coef in Model.CoefficientFields)
        {
            <div class="form-group mb-4">
                <label class="fw-bold h5">@coef.Label</label>
                <span class="text-secondary">
                    (@coef.Description)</span>

                @{
                    var requiredAttr = coef.IsRequired ? "required" : "";
                    var validationAttr = !string.IsNullOrEmpty(coef.ValidationPattern)
                    ? $"data-validation='{coef.ValidationPattern}' data-errormessage='{coef.ErrorMessage}'"
                    : "";
                }
                @switch (coef.inputType)
                {
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Text:
                        <input type="text" name="@coef.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr) />
                        break;
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Url:
                        <input type="url" inputmode="url" name="@coef.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr) />
                        break;
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Number:
                        <input type="number" name="@coef.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr) />
                        break;
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.File:
                        <input type="file" name="@coef.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr) />
                        break;
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Checkbox:
                        <input type="checkbox" name="@coef.Name" value="true" @requiredAttr @Html.Raw(validationAttr) />
                        break;
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Dropdown:
                        <select name="@coef.Name" class="form-control" @requiredAttr @Html.Raw(validationAttr)>
                            <option value="">-- انتخاب کنید --</option>
                            @if (Model.CoefficientList != null && Model.CoefficientList.Any())
                            {
                                // فقط آیتم‌هایی که مربوط به این فیلد هستن
                                var options = Model.CoefficientList
                                .Where(c => c.CoefficientId == coef.CoefficientId)
                                .ToList();

                                foreach (var opt in options)
                                {
                                    <option value="@opt.Id">@opt.Name</option>
                                }
                            }
                            else if (!string.IsNullOrEmpty(coef.DropdownOptions))
                            {
                                // اگر CoefficientList خالی بود از DropdownOptions استفاده کن
                                var opts = coef.DropdownOptions.Split('-');
                                foreach (var opt in opts)
                                {
                                    <option value="@opt">@opt</option>
                                }
                            }
                        </select>
                        break;

                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Date:
                        <input type="date" name="@coef.Name" class="form-control" />
                        <span class="text-danger validation-error" style="display:none"></span>
                        break;
                }
                <span class="text-danger validation-error" style="display:none"></span>

            </div>
        }
    }

    <button type="button" id="btnSave" class="btn btn-success mt-4">ذخیره اطلاعات</button>
    <button type="button" id="btnBack" class="btn btn-dark mt-4">برگشت</button>
</form>

<div id="formMessage" style="margin-top:10px;"></div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // ---------------------
            // 🔹 تابع‌های کمکی
            // ---------------------
            function showError(input, msg) {
                input.closest(".form-group").find(".validation-error")
                    .text(msg)
                    .show();
            }

            function validateForm() {
                let isValid = true;
                $("#formSubmission .validation-error").hide();

                $("#formSubmission [name]").each(function () {
                    let input = $(this);
                    let val = input.val()?.trim();
                    let isRequired = input.prop("required");
                    let pattern = input.data("validation");
                    let errorMsg = input.data("errormessage") || "مقدار وارد شده نامعتبر است.";

                    // بررسی اجباری بودن
                    if (isRequired) {
                        if (input.attr("type") === "checkbox") {
                            if (!input.is(":checked")) {
                                showError(input, "این فیلد الزامی است.");
                                isValid = false;
                                return;
                            }
                        } else if (input.attr("type") === "file") {
                            if (input[0].files.length === 0) {
                                showError(input, "لطفاً فایل موردنظر را انتخاب کنید.");
                                isValid = false;
                                return;
                            }
                        } else if (!val) {
                            showError(input, "پر کردن این فیلد الزامی است.");
                            isValid = false;
                            return;
                        }
                    }

                    // بررسی regex
                    if (pattern && val) {
                        let regex = new RegExp(pattern);
                        if (!regex.test(val)) {
                            showError(input, errorMsg);
                            isValid = false;
                        }
                    }
                });

                return isValid;
            }

            // ---------------------
            // 🔹 ذخیره فرم
            // ---------------------
            $("#btnSave").click(function () {
                var $btn = $(this);

                if (!validateForm()) {
                    $("#formMessage").html('<div class="alert alert-danger">لطفاً خطاهای فرم را برطرف کنید.</div>');
                    return;
                }

                $btn.prop("disabled", true).text("در حال ذخیره...");
                var form = $("#formSubmission")[0];
                var formData = new FormData(form);

                $.ajax({
                    url: '@Url.Action("SubmitForm", "StudentHome", new { area = "Student" })',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            $('#formMessage').html('<div class="alert alert-success">' + response.message + '</div>');
                            if (response.redirectUrl) {
                                setTimeout(function () {
                                    window.location.href = "index";
                                }, 1200);
                            }
                        } else {
                            $('#formMessage').html('<div class="alert alert-danger">' + response.message + '</div>');
                        }
                    },
                    error: function () {
                        $('#formMessage').html('<div class="alert alert-danger">خطا در ثبت فرم</div>');
                    },
                    complete: function () {
                        $btn.prop("disabled", false).text("ذخیره اطلاعات");
                    }
                });
            });

            // ---------------------
            // 🔹 برگشت بدون ولیدیشن
            // ---------------------
            $("#btnBack").click(function () {
                window.location.href = '@Url.Action("Index", "StudentHome", new { area = "Student" })';
            });

        });
    </script>
}


