@using SanjeshP.Mosahebe.Entities.StudentForm
@{
    var fields = ViewBag.Fields as IEnumerable<FormItemDefinition> ?? Enumerable.Empty<FormItemDefinition>();
    var selected = ViewBag.Selected as int?;
}

<form asp-action="SubmitForm" asp-controller="StudentHome" asp-area="Student" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="formId" value="@selected" />

    <div class="mt-3">
        @foreach (var f in fields)
        {
            <div class="form-group mb-3">
                <label>@f.Label</label>
                @switch (f.inputType)
                {
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Text:
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Number:
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Url:
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.File:
                        <input type="@(
                            f.inputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.Text ? "text" :
                            f.inputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.Number ? "number" :
                            f.inputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.Url ? "url" :
                            "file"
                        )"
                               name="@f.Name" class="form-control" @(f.IsRequired ? "required" : "") />
                        break;
                    case SanjeshP.Mosahebe.Entities.StudentForm.InputType.Checkbox:
                        <div class="form-check">
                            <input type="checkbox" name="@f.Name" class="form-check-input" @(f.IsRequired ? "required" : "") />
                            <label class="form-check-label">@f.Label</label>
                        </div>
                        break;
                }

                @if (!string.IsNullOrEmpty(f.Description))
                {
                    <small class="form-text text-muted">@f.Description</small>
                }
            </div>
        }
    </div>

    <div class="text-right">
        <button type="submit" class="btn btn-primary">ارسال</button>
        <button type="button" id="btnCancel" class="btn btn-secondary">لغو</button>
    </div>
</form>
