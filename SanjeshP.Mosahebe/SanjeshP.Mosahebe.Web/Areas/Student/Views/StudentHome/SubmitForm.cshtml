@model SanjeshP.Mosahebe.Web.Areas.Student.ViewModels.FormSubmissionViewModel

@{
    ViewData["Title"] = "Submit Form";
}

<h2>فرم شماره @Model.FormId</h2>

<form asp-action="SubmitForm" asp-controller="StudentHome" method="post">
    <input type="hidden" asp-for="FormId" />

    <h3>فیلدهای فرم</h3>
    @foreach (var field in Model.Fields)
    {
        <div>
            <label>@field.Label</label>
            @if (field.inputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.Text)
            {
                <input type="text" name="SubmittedValues[@field.Id]" />
            }
            else if (field.inputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.Number)
            {
                <input type="number" name="SubmittedValues[@field.Id]" />
            }
            else if (field.inputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.Dropdown)
            {
                <select name="SubmittedValues[@field.Id]">
                    @foreach (var option in field.DropdownOptions?.Split('-') ?? new string[0])
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            }
        </div>
    }

    <h3>فیلدهای ضریب</h3>
    @foreach (var coefField in Model.CoefficientFields)
    {
        <div>
            <label>@coefField.Label</label>
            <input type="text" name="SubmittedValues[@coefField.Id]" />
        </div>
    }

    <button type="submit">ارسال فرم</button>
</form>
