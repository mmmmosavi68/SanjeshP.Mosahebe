@model SanjeshP.Mosahebe.Web.Areas.Student.ViewModels.SubmissionDataDetailViewModel

<div>
    <p><strong>@Html.DisplayNameFor(m => m.Title):</strong> @Model.Title</p>
    <p><strong>@Html.DisplayNameFor(m => m.Description):</strong> @Model.Description</p>
    <p><strong>@Html.DisplayName("نوع آزمون"):</strong> @Model.TypeOfExamTitle</p>
    <p><strong>@Html.DisplayNameFor(m => m.IsActive):</strong> @(Model.IsActive ? "فعال" : "غیرفعال")</p>
</div>
