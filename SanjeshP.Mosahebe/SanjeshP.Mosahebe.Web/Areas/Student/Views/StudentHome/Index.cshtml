@model IEnumerable<SanjeshP.Mosahebe.Entities.StudentForm.FormItem>

@{
    ViewData["Title"] = "فرم‌های داوطلب";
}

<div class="container mt-4">

    <h3>انتخاب فرم</h3>

    <div class="row mb-3">
        <div class="col-md-4">
            <select id="formSelect" class="form-control">
                <option value="">-- یک فرم انتخاب کنید --</option>
                @foreach (var form in Model)
                {
                    <option value="@form.Id">@form.Title</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button id="btnAdd" class="btn btn-primary">افزودن فرم</button>
        </div>
    </div>

    <!-- کانتینر فرم داینامیک -->
    <div id="formContainer" style="display:none;"></div>

    <!-- کانتینر جدول رکوردها -->
    <div id="submissionsContainer">
        <h4>رکوردهای ارسال شده</h4>
        <table class="table table-bordered" id="submissionsTable">
            <thead>
                <tr>
                    <th>FormId</th>
                    <th>تاریخ ارسال</th>
                    <th>اقدامات</th>
                </tr>
            </thead>
            <tbody>
                <!-- رکوردها با Ajax بارگذاری می‌شوند -->
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // دکمه افزودن فرم
            $("#btnAdd").click(function () {
                var formId = $("#formSelect").val();
                if (!formId) {
                    alert("لطفاً یک فرم انتخاب کنید.");
                    return;
                }

                $("#submissionsContainer").hide();
                $("#formContainer").show().load("/Student/StudentHome/LoadForm?formId=" + formId);
            });

            // لود رکوردهای ارسال شده
            function loadSubmissions() {
                // مثال: Ajax برای گرفتن رکوردها از کنترلر
                $.get("/Student/StudentHome/GetSubmissions", function (data) {
                    var tbody = $("#submissionsTable tbody");
                    tbody.empty();
                    $.each(data, function (i, item) {
                        tbody.append(
                            `<tr>
                                <td>${item.FormId}</td>
                                <td>${item.CreatedDate}</td>
                                <td><button class='btn btn-sm btn-info'>جزئیات</button></td>
                            </tr>`
                        );
                    });
                });
            }

            loadSubmissions();

        });
    </script>
}
