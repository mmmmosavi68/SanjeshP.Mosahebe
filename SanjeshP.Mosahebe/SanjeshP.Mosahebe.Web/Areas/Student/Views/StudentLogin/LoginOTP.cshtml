@model SanjeshP.Mosahebe.Web.Areas.Student.ViewModels.LoginOTPViewModel

<form asp-controller="StudentLogin" asp-action="LoginOTP" method="post" class="login-form" novalidate data-title="ورود با یکبار رمز">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <div class="input-group neu-input">
            <input asp-for="NationalCode" type="text" placeholder=" " />
            <label for="NationalCode">کد ملی را وارد نمایید</label>
            <div class="input-icon">
                <i class="fa fa-id-card"></i>
            </div>
        </div>
        <span asp-validation-for="NationalCode" class="error-message"></span>
    </div>

    <button type="submit" class="neu-button login-btn">ارسال کد ورود</button>
</form>
