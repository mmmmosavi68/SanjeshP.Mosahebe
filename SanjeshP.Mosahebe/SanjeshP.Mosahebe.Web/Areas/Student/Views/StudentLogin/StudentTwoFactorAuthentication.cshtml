<form method="post" asp-action="StudentTwoFactorAuthentication">
    @Html.AntiForgeryToken()
    <input type="hidden" name="nationalCode" value="@ViewBag.NationalCode" />

    <div class="wrap-input100 validate-input">
        <input asp-for="TwoFactorCode" class="input100" placeholder="کد یکبار مصرف را وارد نمایید">
        <span asp-validation-for="TwoFactorCode" class="focus-input100"></span>
        <span class="symbol-input100">
            <i class="fa fa-envelope" aria-hidden="true"></i>
        </span>
    </div>
    <button type="submit" class="login100-form-btn">تایید</button>
</form>
