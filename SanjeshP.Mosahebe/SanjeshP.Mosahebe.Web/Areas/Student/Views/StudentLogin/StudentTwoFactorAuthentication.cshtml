@model SanjeshP.Mosahebe.Web.Areas.Student.ViewModels.StudentTwoFactorAuthenticationViewModel

<p style="text-align:center; margin-bottom: 20px;color:#FFF;font-weight:900;">لطفاً کد ۲ مرحله‌ای را وارد کنید</p>

<form method="post" asp-action="StudentTwoFactorAuthentication" class="login-form" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="nationalCode" value="@ViewBag.NationalCode" />

    <div class="form-group">
        <div class="input-group neu-input">
            <input asp-for="TwoFactorCode" placeholder=" " />
            <label for="TwoFactorCode">کد یکبار مصرف را وارد نمایید</label>
            <div class="input-icon">
                <i class="fa fa-envelope"></i>
            </div>
        </div>
        <span asp-validation-for="TwoFactorCode" class="error-message"></span>
    </div>

    <div class="form-group">
        <div class="input-group neu-input captcha-input">
            <input asp-for="CaptchaCode" type="text" inputmode="numeric" placeholder=" " aria-label="کد امنیتی" style="width:80%;" maxlength="6" autocomplete="off" />
            <label for="CaptchaCode">کد امنیتی</label>
            <div class="input-icon">
                <img id="captchaImg" src="@Url.Content("~/student/captcha-image")" alt="کپچا"
                     onclick="this.src='@Url.Content("~/student/captcha-image?")' + Math.random();"
                     alt="کپچا"
                     title="برای بارگذاری مجدد کلیک کنید"
                     style="position: relative;left: 75px;top: -10px;height: 42px;" role="button" />
            </div>
        </div>
        <span asp-validation-for="CaptchaCode" class="error-message"></span>
    </div>
    <button type="submit" class="neu-button login-btn">تایید کد / ورود به سیستم</button>
</form>
