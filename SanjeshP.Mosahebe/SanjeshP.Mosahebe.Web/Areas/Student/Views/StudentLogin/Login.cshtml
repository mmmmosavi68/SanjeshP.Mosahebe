@{
    ViewData["Title"] = "ورود به سیستم";
    Layout = "~/Views/Shared/_LoginStudentLayout.cshtml";
}

<div class="login-header">
    <div class="neu-icon">
        <div class="icon-inner">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
        </div>
    </div>
    <h2>ورود به سیستم</h2>
    <p>لطفا برای ادامه وارد شوید</p>
</div>

<div id="loginOptions" class="form-options">
    <div class="remember-wrapper">
        <input type="radio" name="loginMethod" value="LoginOTP" id="optOtp" checked />
        <label class="checkbox-label" for="optOtp">ورود با یکبار رمز</label>
    </div>
    <div class="remember-wrapper">
        <input type="radio" name="loginMethod" value="LoginCodeRahgiri" id="optTrack" />
        <label class="checkbox-label" for="optTrack">ورود با کد رهگیری</label>
    </div>
</div>

<div id="partialContainer"></div>

@section Scripts {
    <script>
        $(function () {
            function loadPartial() {
                var method = $('input[name="loginMethod"]:checked').val();
                var url = '/Student/StudentLogin/' + method;
                $('#partialContainer').load(url);
            }

            loadPartial();

            $('#loginOptions input[name="loginMethod"]').on('change', function () {
                var action = $(this).val();
                var url = '/Student/StudentLogin/' + action;
                $('#partialContainer').load(url);
            });

            $('#partialContainer').on('submit', 'form', function (e) {
                e.preventDefault();
                var $form = $(this);
                $.post($form.attr('action'), $form.serialize())
                    .done(function (response) {
                        if (response.redirectToUrl) {
                            window.location.href = response.redirectToUrl;
                        } else {
                            $('#partialContainer').html(response);
                        }
                    })
                    .fail(function () {
                        alert('خطا در ارسال اطلاعات. دوباره تلاش کنید.');
                    });
            });
        });
    </script>
}
