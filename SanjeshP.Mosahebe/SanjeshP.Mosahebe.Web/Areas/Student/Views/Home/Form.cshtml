@using SanjeshP.Mosahebe.Entities.Student
@model int?

@{
    var fields = ViewBag.Fields as IEnumerable<FieldDefinition> ?? Enumerable.Empty<FieldDefinition>();
    var selected = ViewBag.Selected as int?;
    var message = ViewBag.Message as string;
}

<h4>فرم شماره @(selected ?? 0)</h4>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success">@message</div>
}

<form asp-action="SubmitForm" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="formId" value="@selected" />

    <div class="mt-3">
        @foreach (var f in fields)
        {
            <div class="form-group">
                <label>@f.Label</label>
                @{
                    var t = f.Type switch
                    {
                        FieldType.Text => "text",
                        FieldType.Number => "number",
                        FieldType.Url => "url",
                        FieldType.File => "file",
                        FieldType.Checkbox => "checkbox",
                        _ => "text"
                    };
                }
                <input name="@f.Name"
                       type="@t"
                       class="form-control"
                @(f.IsRequired ? "required" : "") />

                @if (!string.IsNullOrEmpty(f.Description))
                {
                    <small class="form-text text-muted">@f.Description</small>
                }
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">ارسال</button>
</form>