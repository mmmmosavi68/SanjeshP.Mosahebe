@model IEnumerable<int>

<h4>انتخاب فرم</h4>

<form asp-action="Form" method="get">
    <select name="formId" class="form-control" onchange="this.form.submit()">
        <option value="">انتخاب فرم</option>
        @foreach (var id in Model)
        {
            <option value="@id">فرم @id</option>
        }
    </select>
</form>
