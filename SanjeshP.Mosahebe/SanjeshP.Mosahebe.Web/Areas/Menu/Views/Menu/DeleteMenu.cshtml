@using SanjeshP.Mosahebe.Web.Areas.Menu.ViewModels.Menu
@model DeleteMenuViewModel

<div class="row">
    <div class="col-md-12">
        <form id="delete-menu-form" asp-action="DeleteMenu" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" id="validation-summary"></div>

            <!-- نمایش ParentTitle -->
            <div class="form-group">
                <label class="control-label col-sm-4">منو انتخابی جهت حذف:</label>
                <input type="text" class="form-control col-sm-7 d-inline-block" value="@Model.MenuTitle" disabled />
            </div>

            <!-- عنوان -->
            <div class="form-group">
                <span>برای حذف منو، نام منو را دقیقاً در کادر زیر وارد کنید.</span>
                <span>توجه داشته باشید که این عمل برگشت‌پذیر نیست و منو، صفحه و آیتم‌های مربوط به آن از سیستم حذف خواهند شد.</span>
                <hr />
                <label asp-for="MenuTitle" class="control-label col-sm-4"></label>
                <input asp-for="MenuTitle" class="form-control col-sm-7 d-inline-block" value="" />
                <span asp-validation-for="MenuTitle" class="text-danger"></span>
            </div>

            <!-- فیلد ParentId -->
            <input type="hidden" asp-for="Id" value="@Model.Id" />

            <div class="form-group">
                <input type="button" id="delete-button" value="حذف منو" class="btn btn-danger" />
            </div>
        </form>
    </div>
</div>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
<script>
    $(document).ready(function () {
        $('#delete-button').click(function () {
            $.ajax({
                url:window.__env.baseUrl + window.routes.menu.menu_deletemenu,
                type: 'POST',
                data: $('#delete-menu-form').serialize(),
                success: function (response) {
                    if (response.isSuccess) {
                        $('#Modal_AddEdit').modal('hide');
                        iziToast.success({ message: response.message });
                        $("#menuTree").load(window.__env.baseUrl + window.routes.menu.menu_currentusermenu);
                    } else {
                        var errors = response.message.split(' | ');
                        errors.forEach((item) => {
                            iziToast.error({ message: item });
                        });
                    }
                },
                error: function () {
                    iziToast.error({
                        message: 'خطایی رخ داده است. لطفاً دوباره تلاش کنید.'
                    });
                }
            });
        });
    });
</script>