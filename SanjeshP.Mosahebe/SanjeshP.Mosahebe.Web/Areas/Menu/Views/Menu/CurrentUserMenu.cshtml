     $(document).ready(function () {
        $('#resetButton').click(function () {
            $.ajax({
                url: '@Url.Action("ResetMenu", "Menu")',
                type: 'POST',
                success: function (response) {
                    if (response.isSuccess) {
                        iziToast.success({ message: response.message });
                    } else {
                        var errors = response.message.split(' | ');
                        errors.forEach((item) => {
                            iziToast.error({ message: item });
                        });
                    }
                },
                error: function (response) {
                        var errors = response.responseText.split(' | ');
                        errors.forEach((item) => {
                            iziToast.error({ message: item });
                        });
                }
            });
        });
    });
</script>
