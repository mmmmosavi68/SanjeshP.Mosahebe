@model SanjeshP.Mosahebe.Web.Areas.Interview.ViewModels.Station.StationCreateViewModel

<form id="create-station-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="button" id="save-button" class="btn btn-success">افزودن ایستگاه</button>
</form>

<script>
    $('#save-button').click(function () {
        $.ajax({
            url: '/Interview/Station/CreateStation',
            type: 'POST',
            data: $('#create-station-form').serialize(),
            success: function (res) {
                if (res.isSuccess) {
                    $('#Modal_AddEdit').modal('hide');
                    $("#StationList").load("/Interview/Station/StationList");
                    iziToast.success({ message: 'ایستگاه با موفقیت افزوده شد' });
                } else {
                    iziToast.error({ message: res.message });
                }
            }
        });
    });
</script>
