@model IEnumerable<SanjeshP.Mosahebe.Web.Areas.Interview.ViewModels.Station.StationViewModel>

<div class="bg-light rounded p-4">
    <h3>فهرست ایستگاه‌ها</h3>

    <div class="row mb-3">
        <input type="button" class="btn btn-outline-primary" onclick="CreateStation()" value="افزودن ایستگاه جدید" />
    </div>

    <table class="table table-striped table-hover text-center" id="tbl_station">
        <thead>
            <tr>
                <th>#</th>
                <th>نام ایستگاه</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                foreach (var s in Model)
                {
                    <tr id="tr_@(s.Id)">
                        <td>@i</td>
                        <td>@s.Name</td>
                        <td>@(s.IsActive ? "فعال" : "غیرفعال")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-warning" onclick="EditStation('@s.Id')"><i class="fa fa-edit"></i></a>
                            <a class="btn btn-sm btn-outline-primary" onclick="StationQuestionList('@s.Id','@s.Name')"><i class="fa fa-question"></i></a>
                            <a class="btn btn-sm btn-outline-dark" onclick="FieldStationList('@s.Id','@s.Name')"><i class="fa fa-layer-group"></i></a>
                            <a class="btn btn-sm btn-outline-danger" data-id="@s.Id" data-toggle="DeleteStation"><i class="fa fa-trash"></i></a>
                        </td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
</div>

<script src="~/js/bootstrap-confirmation.min.js"></script>
<script src="~/admin/plugins/datatables/jquery.datatables.min.js"></script>
<script src="~/admin/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

<script>
    $(function () {
        $('#tbl_station').DataTable({
            paging: true,
            searching: true,
            lengthChange: true,
            ordering: true,
            info: true,
            autoWidth: false
        });
    });

        function CreateStation() {
            openModal('افزودن ایستگاه جدید', '/Interview/Station/CreateStation', false);
        }

        function EditStation(id) {
            openModal('ویرایش ایستگاه', '/Interview/Station/EditStation?id=' + id, false);
        }

        function DetailStation(id) {
            openModal('جزئیات ایستگاه', '/Interview/Station/DetailStation?id=' + id, false);
        }
        function StationQuestionList(stationId, name) {
            openModal('سوالات ایستگاه _ ' + name, '/Interview/StationQuestion/Index?stationId=' + stationId, true);
        }
        function FieldStationList(stationId, name) {
            openModal('رشته های ایستگاه _ ' + name, '/Interview/FieldStation/Index?stationId=' + stationId, true);
        }
