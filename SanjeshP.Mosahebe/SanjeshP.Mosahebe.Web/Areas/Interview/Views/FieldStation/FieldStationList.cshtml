@using SanjeshP.Mosahebe.Web.Areas.Interview.ViewModels.FieldStation
@model IEnumerable<FieldStationViewModel>

<div class="row mb-2">
    <button class="btn btn-primary" onclick="AddFieldToStation('@ViewData["StationId"]')">افزودن رشته به ایستگاه</button>
</div>

<table class="table-striped table-hover table" id="tbl_fieldstation">
    <thead>
        <tr>
            <th>#</th>
            <th>رشته</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
        }
        @foreach (var item in Model)
        {
            <tr id="tr_@item.Id">
                <td>@i</td>
                <td>@item.FieldTitle</td>
                <td>
                    <button class="btn btn-danger btn-sm" onclick="RemoveFieldFromStation(@item.Id)">حذف</button>
                </td>
            </tr>
            i++;
        }
    </tbody>
</table>

<script src="~/js/bootstrap-confirmation.min.js"></script>
<script src="~/admin/plugins/datatables/jquery.datatables.min.js"></script>
<script src="~/admin/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

<script>
    $(function () {
        $('#tbl_fieldstation').DataTable({
            paging: true,
            searching: true,
            lengthChange: true,
            ordering: true,
            info: true,
            autoWidth: false
        });
    });

    function RemoveFieldFromStation(id) {
        $.post('/Interview/FieldStation/RemoveFieldFromStation', { id: id }, function() {
            $("#tr_" + id).remove();
            iziToast.success({ message: 'رشته از ایستگاه حذف شد.' });
        });
    }

    function AddFieldToStation(stationId) {
        openModal('افزودن رشته به ایستگاه', '/Interview/FieldStation/FieldsNotInStation?stationId=' + stationId, false);
    }
</script>
