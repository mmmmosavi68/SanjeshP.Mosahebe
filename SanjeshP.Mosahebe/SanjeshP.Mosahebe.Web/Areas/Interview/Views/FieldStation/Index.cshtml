@{
    var stationId = ViewData["StationId"];
}
<div class="modal-body" id="field_station_body">
    <span>در حال بارگذاری...</span>
</div>

<script>
    $(document).ready(function () {
        var stationId = '@stationId';
        $("#field_station_body").load(window.__env.baseUrl +'/' + window.routes.fieldstation.fieldstation_fieldstationlist+'?stationId=' + stationId,false);
    });
</script>
