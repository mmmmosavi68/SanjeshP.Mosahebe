@using SanjeshP.Mosahebe.Web.Areas.Interview.ViewModels.StudentInterview
@model StudentInterviewQuestionViewModel

<div class="p-3  table-responsive">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0">مصاحبه داوطلب: @Model.StudentName (@Model.NationalCode)</h4>
            <h5 class="text-muted">ایستگاه: @Model.StationName</h5>
        </div>

        @{
            var nationalCode = Model.NationalCode;
            var userPhotoPath = Url.Content($"~/uploads/{nationalCode}/{nationalCode}.jpg");
            var defaultPhoto = Url.Content("~/img/user.jpg");
        }

        <img src="@userPhotoPath"
             onerror="this.onerror=null;this.src='@defaultPhoto';"
             class="img-thumbnail"
             style="width:100px;height:100px;object-fit:cover;margin-right:10px;"
             alt="user photo" 
             onclick="openImageModal(this.src)" />
    </div>

    <form id="interviewForm" class=" table-responsive">
        <input type="hidden" name="StudentId" value="@Model.StudentId" />
        <input type="hidden" name="StationId" value="@Model.StationId" />

        <table class="table table-bordered text-center">
            <thead>
                <tr>
                    <th>سوال</th>
                    <th>امتیاز</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model.Questions)
                {
                    <tr>
                        <td>@q.QuestionText</td>
                        <td>
                            <select class="form-control" name="Scores[@q.QuestionId]">
                                <option value="">انتخاب کنید</option>
                                @for (decimal i = 0; i <= 1; i += 0.25m)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-success float-right col-2">ثبت نمرات</button>
    </form>
</div>
<script>
    $(document)
        .off('submit', '#interviewForm')
        .on('submit', '#interviewForm', function (e) {

            e.preventDefault();

            var $form = $(this);
            var $btn = $form.find("button[type=submit]");
            var oldText = $btn.text();

            if ($btn.prop('disabled')) return;
            $btn.prop('disabled', true).text('در حال ثبت...');

            let allAnswered = true;
            $form.find("select[name^='Scores']").each(function () {
                if ($(this).val() === "") {
                    allAnswered = false;
                    return false;
                }
            });

            if (!allAnswered) {
                alert("لطفاً به همه سؤالات امتیاز بدهید.");
                $btn.prop('disabled', false).text(oldText);
                return;
            }

            $.ajax({
                url: $form.attr('action') || '/Interview/StudentInterview/SaveInterviewScores',
                method: 'POST',
                data: $form.serialize(),
                success: function () {
                    var stationId = $('#stationSelect').val();
                    if (stationId) {
                        $("#StudentList").load('/Interview/StudentInterview/StudentsList?stationId=' + stationId);
                    } else {
                        $('#StudentList').html('');
                    }
                    $('.modal').modal('hide');
                },
                error: function () {
                    alert('خطا در ذخیره نمرات.');
                },
                complete: function () {
                    $btn.prop('disabled', false).text(oldText);
                }
            });
        });


    function openImageModal(src) {
        // HTML محتوای داخل مودال را می‌سازیم
        const html = `
                <div style="display:flex;justify-content:center;align-items:center;padding:10px;">
                    <img src="${src}"
                         alt="تصویر"
                         style="max-width:100%;max-height:80vh;border-radius:8px;object-fit:contain;" />
                </div>
            `;

        // تبدیل HTML به یک data URI (برای اینکه به openModal بدهیم)
        const encoded = encodeURIComponent(html);
        const dataUrl = "data:text/html;charset=utf-8," + encoded;

        // صدا زدن مودال شما
        openModal('نمایش تصویر', dataUrl, true);
    }
</script>


