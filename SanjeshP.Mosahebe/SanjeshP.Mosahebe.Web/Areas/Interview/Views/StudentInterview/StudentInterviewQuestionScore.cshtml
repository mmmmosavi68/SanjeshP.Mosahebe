@using SanjeshP.Mosahebe.Web.Areas.Interview.ViewModels.StudentInterview
@model StudentInterviewQuestionViewModel

<div class="p-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0">مصاحبه داوطلب: @Model.StudentName (@Model.NationalCode)</h4>
            <h5 class="text-muted">ایستگاه: @Model.StationName</h5>
        </div>

        @{
            var nationalCode = Model.NationalCode;
            var userPhotoPath = Url.Content($"~/uploads/{nationalCode}/{nationalCode}.jpg");
            var defaultPhoto = Url.Content("~/img/user.jpg");
        }

        <img src="@userPhotoPath"
             onerror="this.onerror=null;this.src='@defaultPhoto';"
             class="img-thumbnail"
             style="width:100px;height:100px;object-fit:cover;margin-right:10px;"
             alt="user photo" />
    </div>

    <form id="interviewForm">
        <input type="hidden" name="StudentId" value="@Model.StudentId" />
        <input type="hidden" name="StationId" value="@Model.StationId" />

        <table class="table table-bordered text-center">
            <thead>
                <tr>
                    <th>سوال</th>
                    <th>امتیاز</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model.Questions)
                {
                    <tr>
                        <td>@q.QuestionText</td>
                        <td>
                            <select class="form-control" name="Scores[@q.QuestionId]">
                                <option value="">انتخاب کنید</option>
                                @for (double i = 0; i <= 1; i += 0.25)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-success">ثبت نمرات</button>
    </form>
</div>
<script>
    $("#interviewForm").submit(function (e) {
        e.preventDefault();

        var $form = $(this); // ✅ فرم فعلی
        var $btn = $form.find("button[type=submit]"); // ✅ دکمه ارسال
        var oldText = $btn.text();

        // بررسی اینکه همه selectها مقدار داشته باشند
        let allAnswered = true;
        $("#interviewForm select[name^='Scores']").each(function () {
            if ($(this).val() === "") {
                allAnswered = false;
                return false; // خروج از حلقه
            }
        });
        //console.log(allAnswered);
        if (!allAnswered) {
            alert("لطفاً به همه سؤالات امتیاز بدهید.");
            return; // ارسال انجام نشود
        }

        // اگر همه پر بودند، ارسال انجام شود
        //$.post('/Interview/StudentInterview/SaveInterviewScores', $(this).serialize(), function (res) {
        //    alert("نمرات با موفقیت ثبت شد!");
        //    closeModal();
        //});
        // اگر از antiforgery استفاده می‌کنید، توکن در فرم وجود دارد و serialize آن را شامل می‌شود
        var data = $form.serialize();

        $.ajax({
            url: $form.attr('action') || '/Interview/StudentInterview/SaveInterviewScores',
            method: 'POST',
            data: data,
            success: function (response) {
                // اگر کنترلر Ok با JSON برمی‌گرداند می‌توانید چک کنید response.success
                // اما ساده‌ترین حالت: اگر موفقیت آمیز باشد، لیست دانشجویان مجدداً لود شود

                var stationId = $('#stationSelect').val();
                if (stationId) {
                    $("#StudentList").load('/Interview/StudentInterview/StudentsList?stationId=' + stationId);
                } else {
                    $('#StudentList').html('');
                }

                // اگر فرم داخل مودال باز شده بود، آن را ببندید
                // فرض: از openModal استفاده می‌کنید که modal را باز کرده؛ اگر modal bootstrap دارید:
                $('.modal').modal('hide');
            },
            error: function (xhr) {
                // در صورت بازگشت JSON حاوی پیام خطا، می‌توانید آن را نمایش دهید
                alert('خطا در ذخیره نمرات. لطفاً دوباره تلاش کنید.');
            },
            complete: function () {
                $btn.prop('disabled', false).text(oldText);
            }
        });
    });
</script>


