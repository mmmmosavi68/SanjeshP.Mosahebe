@{
    ViewData["Title"] = "Form Item Definitions";
}

<div id="FormItemDefinitionList"></div>


<script>
    $(document).ready(function () {
        // PartialView لیست آیتم‌ها را بارگذاری می‌کنیم
        $("#FormItemDefinitionList").load("/StudentForm/FormItemDefinition/FormItemDefinitionList?formItemId=@ViewBag.FormItemId");
    });
</script>
