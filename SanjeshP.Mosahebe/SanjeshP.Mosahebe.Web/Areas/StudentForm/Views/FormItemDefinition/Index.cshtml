@model IEnumerable<SanjeshP.Mosahebe.Entities.StudentForm.FormItemDefinition>
<h2>تعریف آیتم های فرم</h2>
@*<p>
    <a asp-action="Create" asp-route-formItemId="@ViewBag.FormItemId" class="btn btn-primary">افزودن آیتم جدید</a>
</p>*@
<div class="row mb-3">
    <input type="button" class="btn btn-outline-primary" onclick="CreateDefinition(@ViewBag.FormItemId)" value="افزودن آیتم جدید" />
</div>


<table class ="table table-bordered table-striped">
    <thead>
        <tr>
            <th>نام</th>
            <th>برچسب</th>
            <th>نوع</th>
            <th>اجباری</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr id="tr_@(item.Id)">
                <td>@item.Name</td>
                <td>@item.Label</td>
                <td>@item.inputType</td>
                <td>@(item.IsRequired ? "بله" : "خیر")</td>
                <td>
                    <a class="btn btn-sm btn-outline-warning" onclick="EditDefinition('@item.Id')" title="ویرایش"><i class="fa fa-pen"></i></a>
                    @*<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="ویرایش"><i class="fa fa-pen"></i></a>*@
                    <a class="btn btn-sm btn-outline-danger" id="@item.Id" data-toggle="DeleteFormItemDefinition" title="حذف"><i class="fa fa-trash"></i></a>

@*
                    <a asp-action="Edit" asp-route-id="@item.Id">ویرایش</a> |
                    <form asp-action="Delete" asp-route-id="@item.Id" asp-route-formItemId="@item.FormItemId" method="post" style="display:inline;">
                        <button type="submit">حذف</button>
                    </form>*@
                </td>
            </tr>
        }
    </tbody>
</table>
@section scripts {
    <script src="~/js/bootstrap-confirmation.min.js"></script>
    <script src="~/admin/plugins/datatables/jquery.datatables.min.js"></script>
    <script src="~/admin/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/admin/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script>
        $('Table').DataTable({
            paging: true,
            searching: true,
            lengthChange: true,
            ordering: true,
            info: true,
            autoWidth: false,
            buttons: ["copy", "csv", "excel", "pdf", "print", "colvis"]
        }).buttons().container().appendTo('#tbl_exam_wrapper .col-md-6:eq(0)');

        $('[data-toggle="DeleteFormItemDefinition"]').confirmation({
            title: 'آیا از حذف مطمئن هستید؟',
            btnCancelClass: 'btn btn-sm btn-primary',
            btnCancelLabel: 'انصراف',
            btnOkClass: 'btn btn-sm btn-danger',
            btnOkLabel: 'حذف',
            onConfirm: function () {
                DeleteItemDefinition($(this).attr('id'));
            }
        });

        function CreateDefinition(formItemId) {
            openModal('افزودن آیتم جدید', '/StudentForm/FormItemDefinition/Create?formItemId=' + formItemId, false);
        }

        function EditDefinition(id) {
            openModal('ویرایش آیتم', '/StudentForm/FormItemDefinition/Edit?id=' + id, false);
        }

        function DeleteItemDefinition(id) {
            var token = $('input[name="__RequestVerificationToken"]').val(); // اگر در صفحه فرم دارید
            $.ajax({
                method: "POST",
                url: "/StudentForm/FormItemDefinition/Delete",
                data: {
                    Id: id,
                    __RequestVerificationToken: token
                },
                success: function (response) {
                    $("#tr_" + id).addClass("bg-danger").hide('slow');
                },
                error: function (asa) {
                    console.log(asa)
                    Toast.fire({
                        icon: 'error',
                        title: 'آیتمی جهت حذف ارسال نشده است یا خطایی رخ داده.'
                    });
                }
            });
        }
    </script>
}