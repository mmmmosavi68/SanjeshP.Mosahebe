@model SanjeshP.Mosahebe.Presentation.ViewModels.FormItemDefinitionCreateViewModel

<form id="formItemDefinitionForm" asp-action="@ViewBag.FormAction" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="FormItemId" />
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label asp-for="Name">نام آیتم</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Label">برچسب قابل نمایش</label>
        <input asp-for="Label" class="form-control" />
        <span asp-validation-for="Label" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="InputType">نوع فیلد ورودی</label>
        <select asp-for="InputType" id="InputType" class="form-control"
                asp-items="Html.GetEnumSelectList<SanjeshP.Mosahebe.Entities.StudentForm.InputType>()"></select>
        <span asp-validation-for="InputType" class="text-danger"></span>
    </div>

    <div class="form-group mb-3" id="dropdown-options-container" style="display:none;">
        <label asp-for="DropdownOptions">گزینه‌های لیست (فقط برای Dropdown)</label>
        <input asp-for="DropdownOptions" class="form-control" placeholder="مثال: گزینه1-گزینه2-گزینه3" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description">توضیحات</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ValidationPattern">قاعده اعتبارسنجی (Regex)</label>
        <input asp-for="ValidationPattern" class="form-control" placeholder="مثال: ^\\d+$ برای عدد" />
        <span asp-validation-for="ValidationPattern" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ErrorMessage">پیغام خطا درصورت اشتباه بودن</label>
        <input asp-for="ErrorMessage" class="form-control" placeholder="مثال: لطفاً فقط عدد وارد کنید" />
        <span asp-validation-for="ErrorMessage" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <div class="custom-control custom-checkbox">
            <input type="checkbox" asp-for="IsRequired" class="custom-control-input" id="IsRequired" />
            <label class="custom-control-label" for="IsRequired">آیتم اجباری باشد؟</label>
        </div>
    </div>
</form>

<button type="button" class="btn @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "btn-success" : "btn-warning")"
        onclick="submitFormItemDefinitionForm()">
    @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "ذخیره" : "ویرایش")
</button>

<partial name="_ValidationScriptsPartial" />

<script>
    $(document).ready(function () {

        function toggleDropdownOptions() {
            var selectedValue = parseInt($("#InputType").val());
            if (selectedValue === 7) { // 7 = Dropdown
                $("#dropdown-options-container").show();
            } else {
                $("#dropdown-options-container").hide();
            }
        }

        toggleDropdownOptions();

        $("#InputType").on("change", function () {
            toggleDropdownOptions();
        });

    });

    // AJAX ارسال فرم
    function submitFormItemDefinitionForm() {
        var form = $("#formItemDefinitionForm");
        $.ajax({
            type: form.attr('method'),
            url: form.attr('action'),
            data: form.serialize(),
            success: function (partialViewResult) {
                // بستن مودال
                $("#formItemDefinitionModal").modal('hide');
                // جایگذاری PartialView لیست آیتم‌ها
                $("#FormItemDefinitionList").load(`/StudentForm/FormItemDefinition/FormItemDefinitionList?formItemId=${@Model.FormItemId}`);
                iziToast.success({ message: 'آیتم با موفقیت ثبت شد' });
            },
            error: function () {
                iziToast.error({ message: 'خطا در ثبت آیتم' });
            }
        });
    }
</script>
