    //     } else {
    //         console.warn(`اکشن "${action}" تعریف نشده.`);
    //     }
    // });

    // const userActions = {
    //     detail: id => openModal('مشخصات کاربر', `${window.__env.baseUrl}/User/Users/DetailUser?userid=${id}`, false),
    //     create: () => openModal('افزودن کاربر', `${window.__env.baseUrl}/User/Users/CreateUser`, false),
    //     edit: id => openModal('ویرایش کاربر', `${window.__env.baseUrl}/User/Users/EditUser?userid=${id}`, false),
    //     delete: id => {
    //         $.ajax({
    //             method: "POST",
    //             url: `${window.__env.baseUrl}/User/Users/DeleteUser?userid=${id}`,
    //             success: response => { /* هندل موفقیت */ },
    //             error: () => { /* هندل خطا */ }
    //         });
    //     },
    //     access: id => openModal('سطح دسترسی کاربر', `${window.__env.baseUrl}/User/Users/UserAccessMenu?userid=${id}`, false)
    // };

    function DeleteUser(UserID) {
        $(".skeleton-table").show();
         $.ajax({
                method: "POST",
                url: window.__env.baseUrl + "/User/Users/DeleteUser?userid=" + UserID,
                success: function (response) {
                    if (response.isSuccess) {
                         $("#tr_" + UserID).addClass("bg-danger").hide('slow', function() {
                              Toast.fire({
                                    icon: 'success',
                                    title: response.message,
                              })
                        });

                        // این کد PartialView را بارگذاری می‌کند
                        $("#usersList").load("/User/UserS/UsersList", function () {
                            // حذف اسکلتی جدول بعد از بارگذاری
                            $(".skeleton-table").remove();
                        });
                    } else {
                         Toast.fire({
                                icon: 'warning',
                                title: response.message,
                         })
                    }
                },
                error: function () {
                    Toast.fire({
                        icon: 'error',
                        title: 'کاربری جهت حذف ارسال نشده است یا خطایی رخ داده.',
                    })
                }
            });
    };
</script>
