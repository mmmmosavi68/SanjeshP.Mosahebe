@model SanjeshP.Mosahebe.Web.Areas.User.ViewModels.User.ImportUserExcelMappingViewModel

<form id="import-user-excel-form">

    <input type="hidden" asp-for="TempKey" />

    <div class="form-group">
        <label asp-for="RoleId"></label>
        <select asp-for="RoleId" asp-items="Model.Roles" class="form-control"></select>
    </div>

    @foreach (var field in new[]
    {
    (nameof(Model.FirstNameColumn), "نام"),
    (nameof(Model.LastNameColumn), "نام خانوادگی"),
    (nameof(Model.PhoneNumberColumn), "شماره همراه"),
    (nameof(Model.NationalCodeColumn), "کد ملی"),
    (nameof(Model.EmailAddressColumn), "ایمیل"),
    (nameof(Model.UserNameColumn), "نام کاربری"),
    (nameof(Model.PasswordColumn), "رمز عبور"),
    (nameof(Model.IsActiveColumn), "فعال"),
    (nameof(Model.FieldCodesColumn), "کد رشته‌ها")
    })
    {
        <div class="form-group">
            <label>@field.Item2</label>
            <select name="@field.Item1" class="form-control excel-column">
                <option value="">انتخاب ستون</option>
                @foreach (var col in Model.ExcelColumns)
                {
                    <option value="@col">@col</option>
                }
            </select>
        </div>
    }

    <button type="button" id="save-excel-users" class="btn btn-success">
        ثبت کاربران
    </button>
</form>

<script>
    // 💡 مهم: مطمئن شوید که کد تکراری مربوط به $('#upload-excel-btn').click(...)
    // که در انتهای ویو UploadUserExcelMapping.cshtml گذاشته بودید، حذف شده باشد.

    // 1. منطق جلوگیری از انتخاب ستون تکراری (همان منطق قبلی)
    // $('.excel-column').change(function () {
    //     let val = $(this).val();
    //     if (!val) return;

    //     // از تکراری شدن ستون‌ها جلوگیری می‌کند
    //     $('.excel-column').not(this).each(function () {
    //         if ($(this).val() === val) {
    //             iziToast.warning({ message: 'این ستون قبلاً انتخاب شده است' });
    //             $(this).val('');
    //         }
    //     });
    //});

    // 2. منطق ذخیره کاربران (فراخوانی SaveUsersFromExcel)
    $('#save-excel-users').click(function () {
        var formData = $('#import-user-excel-form').serialize();

        // غیرفعال کردن دکمه هنگام ارسال
        var $btn = $(this);
        $btn.prop('disabled', true).text('در حال ثبت...');

        $.ajax({
            url: '/User/Users/SaveUsersFromExcel', // ✅ اکشن صحیح برای ذخیره
            type: 'POST',
            data: formData,
            success: function (response) {
                // فرض بر این است که اکشن شما یک آبجکت شامل { isSuccess: true/false, message: "..." } برمی‌گرداند.
                if (response.isSuccess) {
                    iziToast.success({ message: response.message });
                    listLoader.load("usersList", window.__env.baseUrl + window.routes.users.users_listPaged);

                    // بستن مودال (با توجه به شناسه مودال شما که در کامنت قبل استفاده شد)
                    $('#dynamicModal1').modal('hide');

                    // می‌توانید در اینجا لیست کاربران را به‌روزرسانی کنید.
                    // مثال: LoadUsersList();
                } else {
                    var message = response.message || 'خطا در ثبت کاربران';
                    iziToast.error({ message: message });
                }
            },
            error: function (xhr) {
                var message = xhr.responseJSON ? xhr.responseJSON.message : xhr.responseText;
                iziToast.error({ message: message || 'خطایی در ارتباط با سرور رخ داد.' });
            },
            complete: function () {
                // فعال‌سازی مجدد دکمه
                $btn.prop('disabled', false).text('ثبت کاربران');
            }
        });
    });
</script>