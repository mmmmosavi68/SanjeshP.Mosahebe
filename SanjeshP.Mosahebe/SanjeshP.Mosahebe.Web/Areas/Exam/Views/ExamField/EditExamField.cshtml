@model SanjeshP.Mosahebe.Web.Areas.Exam.ViewModels.ExamField.ExamFieldEditViewModel

<div class="row">
    <div class="col-md-12">
        <form id="edit-exam-field-form" asp-action="EditExamField" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExamId" />

            <div asp-validation-summary="ModelOnly" class="text-danger" id="validation-summary"></div>

            <div class="form-group">
                <label asp-for="StandardCode" class="control-label col-sm-4"></label>
                <input asp-for="StandardCode" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="StandardCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Title" class="control-label col-sm-4"></label>
                <input asp-for="Title" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="button" id="save-edit-examfield-button" value="ذخیره تغییرات" class="btn btn-warning text-white" />
            </div>
        </form>
    </div>
</div>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script>
    $(document).ready(function () {
        $('#save-edit-examfield-button').click(function () {
            $.ajax({
                url: '@Url.Action("EditExamField", "ExamField")',
                type: 'POST',
                data: $('#edit-exam-field-form').serialize(),
                success: function (response) {
                    if (response.isSuccess) {
                        $('#Modal_AddEdit').modal('hide');
                        iziToast.success({ message: response.message });
                       $("#ExamFieldList").load("/Exam/ExamField/ExamFieldList?examId=" + @Model.ExamId, function () {});
                    } else {
                        var errors = response.message.split(' | ');
                        errors.forEach((item) => {
                            iziToast.error({ message: item });
                        });
                    }
                },
                error: function () {
                    iziToast.error({
                        message: 'خطایی در ذخیره تغییرات رخ داده است.'
                    });
                }
            });
        });
    });
</script>
