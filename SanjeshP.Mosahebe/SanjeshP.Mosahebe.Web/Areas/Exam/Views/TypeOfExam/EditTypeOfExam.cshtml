@model SanjeshP.Mosahebe.Web.Areas.Exam.ViewModels.TypeOfExam.TypeOfExamEditViewModel

<div class="row">
    <div class="col-md-12">
        <form id="edit-TypeOfExam-form" asp-action="EditTypeOfExam" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger" id="validation-summary"></div>

            <div class="form-group">
                <label asp-for="StandardCode" class="control-label col-sm-4"></label>
                <input asp-for="StandardCode" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="StandardCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Title" class="control-label col-sm-4"></label>
                <input asp-for="Title" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label col-sm-4"></label>
                <input asp-for="Description" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IsActive" class="control-label col-sm-4"></label>
                <select asp-for="IsActive" class="form-control col-sm-7 d-inline-block">
                    <option value="true">فعال</option>
                    <option value="false">غیرفعال</option>
                </select>
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="button" id="save-edit-button" value="ذخیره تغییرات" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script>
    $(document).ready(function () {
        $('#save-edit-button').click(function () {
            $.ajax({
                url: '@Url.Action("EditTypeOfExam", "TypeOfExam")',
                type: 'POST',
                data: $('#edit-TypeOfExam-form').serialize(),
                success: function (response) {
                    if (response.isSuccess) {
                        $('#Modal_AddEdit').modal('hide');
                        iziToast.success({
                            message: response.message,
                        });
                        $("#typeOfExamList").load("/Exam/TypeOfExam/TypeOfExamsList");
                    } else {
                        iziToast.error({ message: response.message });
                    }
                },
                error: function () {
                    iziToast.error({ message: 'خطایی رخ داده است. لطفاً دوباره تلاش کنید.' });
                }
            });
        });
    });
</script>
