@model SanjeshP.Mosahebe.Web.Areas.Exam.ViewModels.TypeOfExam.TypeOfExamCreateViewModel

<div class="row">
    <div class="col-md-12">
        <form id="create-TypeOfExam-form" asp-action="CreateTypeOfExam" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" id="validation-summary"></div>
            <div class="form-group">
                <label asp-for="StandardCode" class="control-label col-sm-4"></label>
                <input asp-for="StandardCode" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="StandardCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title" class="control-label col-sm-4"></label>
                <input asp-for="Title" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label col-sm-4"></label>
                <input asp-for="Description" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
          

            <div class="form-group">
                <input type="button" id="save-button" value="افزودن آزمون" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script>
    $(document).ready(function () {
        $('#save-button').click(function () {
            $.ajax({
                url: '@Url.Action("CreateTypeOfExam", "TypeOfExam")',
                type: 'POST',
                data: $('#create-TypeOfExam-form').serialize(),
                success: function (response) {
                    if (response.isSuccess) {
                        $('#Modal_AddEdit').modal('hide');
                        iziToast.success({
                            message: response.message,
                        });
                        // این کد PartialView را بارگذاری می‌کند
                        $("#typeOfExamList").load("/Exam/TypeOfExam/TypeOfExamsList", function () {});
                    } else {
                        var errors = response.message.split(' | ');
                        errors.forEach((item) => {
                            iziToast.error({
                                message: item,
                            });
                        });
                    }
                },
                error: function () {
                    iziToast.error({
                        message: 'خطایی رخ داده است. لطفاً دوباره تلاش کنید.'
                    });
                }
            });
        });
    });



</script>
