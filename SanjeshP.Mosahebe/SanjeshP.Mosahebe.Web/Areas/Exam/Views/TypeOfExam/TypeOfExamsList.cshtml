
@{
    ViewData["Title"] = "TypeOfExamsList";
}

   
@using SanjeshP.Mosahebe.Web.Areas.Exam.ViewModels.TypeOfExam
@model IEnumerable<TypeOfExamViewModel>
@{
    int i = 1;
}
<div class="bg-light rounded p-4">
    <h3>فهرست دسته بندی آزمون‌های مرکز سنجش آموزش پزشکی</h3>
    <div class="row mb-3">
        <input type="button" class="btn btn-outline-primary" onclick="CreateEvent()" value="افزودن دسته بندی جدید" />
    </div>

    <table class="table-hover table-striped table text-center" id="tbl_event">
        <thead>
            <tr class='trhead'>
                <th>#</th>
                <th>
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input selectAll" id="selectAll">
                        <label class="custom-control-label" for="selectAll"></label>
                    </div>
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Title)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Description)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.StandardCode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsActive)

                </th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="tr_@(item.Id)">
                    <th scope="row">@i</th>
                    <th scope="row">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="@item.Id">
                            <label class="custom-control-label" for="@item.Id"></label>
                        </div>

                    </th>
                    <td>
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StandardCode)
                    </td>
                    <td>
                        @(item.IsActive ? "فعال" : "غیرفعال")
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-info" onclick="DetailEvent('@item.Id')" title="اطلاعات آزمون"><i class="fa fa-info"></i></a>
                        <a class="btn btn-sm btn-outline-warning" onclick="EditEvent('@item.Id')" title="ویرایش آزمون"><i class="fa fa-edit"></i></a>
                        <a class="btn btn-sm btn-outline-danger" id="@item.Id" data-toggle="DeleteEvent" title="حذف آزمون"><i class="fa fa-trash"></i></a>
                    </td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>
<script src="~/js/bootstrap-confirmation.min.js"></script>  <!-- For confirmed delete -->
<script src="~/admin/plugins/datatables/jquery.datatables.min.js"></script>
<script src="~/admin/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/admin/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
<script type="text/javascript">
    $(function () {
        $('#tbl_event').DataTable({
            "paging": true,
            "searching": true,
            "lengthChange": true,
            "ordering": true,
            "info": true,
            "autoWidth": true,
            "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
        }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
    });

    $('.selectAll').click(function (e) {
        var table = $(e.target).closest('table');
        $('th input:checkbox', table).prop('checked', this.checked);
    });

    $('.modal-dialog').draggable({
        "handle": ".modal-header"
    });

    $('[data-toggle="DeleteEvent"]').confirmation({
        title: 'آیا از حذف مطمئن هستید؟',
        btnCancelClass: 'btn btn-sm btn-primary',
        btnCancelLabel: 'انصراف',
        btnOkClass: 'btn btn-sm btn-danger',
        btnOkLabel: 'حذف',
        onConfirm: function () { DeleteEvent($(this).attr('id')) }
    });
    function CreateEvent() {
        openModal('افزودن آزمون جدید', '/Exam/TypeOfExam/CreateTypeOfExam', false);
    };
    function DetailEvent(Id) {
        openModal('جزئیات آزمون', '/Exam/TypeOfExam/DetailTypeOfExam?Id=' + Id, false);
    };
    function EditEvent(Id) {
        openModal('ویرایش آزمون', '/Exam/TypeOfExam/EditTypeOfExam?Id=' + Id, false);
    };

    function DeleteEvent(Id) {
        
        $.ajax({
            method: "POST",
            url: "/Exam/TypeOfExam/DeleteTypeOfExam?typeOfExamId=" + Id,
            success: function (response) {
                if (response.isSuccess) {
                    $("#tr_" + Id).addClass("bg-danger").hide('slow', function () {
                        Toast.fire({
                            icon: 'success',
                            title: response.message,
                        })
                    });

                    // این کد PartialView را بارگذاری می‌کند
                      $("#typeOfExamList").load("/Exam/TypeOfExam/TypeOfExamsList");
                } else {
                    Toast.fire({
                        icon: 'warning',
                        title: response.message,
                    })
                }
            },
            error: function () {
                Toast.fire({
                    icon: 'error',
                    title: 'آزمونی جهت حذف ارسال نشده است یا خطایی رخ داده.',
                })
            }
        });
    };
</script>