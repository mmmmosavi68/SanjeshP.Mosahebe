@{
    ViewData["Title"] = "Index";
}

<div id="ExamScheduleList">
</div>


    <script>
        $(document).ready(function () {
            // این کد باعث می‌شود که پنجره‌های مودال قابل جابه‌جایی باشند
            $('.modal-dialog').draggable({
                handle: ".modal-header"
            });

            // این کد PartialView را بارگذاری می‌کند
            $("#ExamScheduleList").load('/Exam/ExamSchedule/ExamScheduleList?examId='+ '@ViewBag.ExamId' , function () {});
        });
    </script>



