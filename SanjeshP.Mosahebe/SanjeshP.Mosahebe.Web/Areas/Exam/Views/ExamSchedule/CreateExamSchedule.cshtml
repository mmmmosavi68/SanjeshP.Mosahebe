@model SanjeshP.Mosahebe.Web.Areas.Exam.ViewModels.ExamSchedule.ExamScheduleCreateViewModel

<div class="row">
    <div class="col-md-12">
        <form id="create-exam-schedule-form" asp-action="CreateExamSchedule" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" id="validation-summary"></div>

            <input type="hidden" asp-for="ExamId" />

            <div class="form-group">
                <label asp-for="EventType" class="control-label col-sm-4">نوع رویداد</label>
                <select asp-for="EventType" class="form-control col-sm-7 d-inline-block"
                        asp-items="Model.EventTypeSelectList">
                    <option value="">انتخاب کنید...</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StartTime" class="control-label col-sm-4">زمان شروع</label>
                <input asp-for="StartTime" type="datetime-local" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EndTime" class="control-label col-sm-4">زمان پایان</label>
                <input asp-for="EndTime" type="datetime-local" class="form-control col-sm-7 d-inline-block" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="button" id="save-schedule-button" value="افزودن زمان‌بندی" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script>
    $(document).ready(function () {
        $('#save-schedule-button').click(function () {
            $.ajax({
                url: '@Url.Action("CreateExamSchedule", "ExamSchedule")',
                type: 'POST',
                data: $('#create-exam-schedule-form').serialize(),
                success: function (response) {
                    if (response.isSuccess) {
                     $("#ExamScheduleList").load('/Exam/ExamSchedule/ExamScheduleList?examId=' + '@Model.ExamId');
                        $('#Modal_AddEdit').modal('hide');
                        iziToast.success({ message: response.message });

                       
                    } else {
                    console.log(response)
                    console.log('eror')

                        var errors = response.message.split(' | ');
                        errors.forEach((item) => {
                            iziToast.error({ message: item });
                        });
                    }
                },
                error: function () {
                    iziToast.error({
                        message: 'خطایی رخ داده است. لطفاً دوباره تلاش کنید.'
                    });
                }
            });
        });
    });
</script>
