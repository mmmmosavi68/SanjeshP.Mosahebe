@using SanjeshP.Mosahebe.Entities.Student
@using SanjeshP.Mosahebe.Web.Areas.DocumentVerification.ViewModels
@model IEnumerable<StudentListViewModel>


@{
    ViewData["Title"] = "ExamsList";
    int i = 1;
}
<style>
    .backcolor {
        background-color: #
    }
</style>
<div class="bg-light rounded p-4">
    <table class="table-hover table-striped table text-center" id="tbl_exam">
        <thead>
            <tr class='trhead'>
                <th>#</th>
                <th>تصویر</th>
                <th>@Html.DisplayNameFor(model => model.First().FirstName)</th>
                <th>@Html.DisplayNameFor(model => model.First().LastName)</th>
                <th>@Html.DisplayNameFor(model => model.First().FatherName)</th>
                <th>@Html.DisplayNameFor(model => model.First().NationalCode)</th>
                <th>@Html.DisplayNameFor(model => model.First().ResearchDocumentScore.IsApproved)</th>
                <th>@Html.DisplayNameFor(model => model.First().ResearchDocumentScore.RejectReason)</th>
                <th>@Html.DisplayNameFor(model => model.First().ResearchDocumentScore.FinalTotalScore)</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var rowClass = item.ResearchDocumentScore?.IsApproved == StudentStatus.Rejected ? "bg-secondary text-white" 
                : item.ResearchDocumentScore?.IsApproved == StudentStatus.Approved ? "bg-success text-white"
                : item.ResearchDocumentScore?.IsApproved == StudentStatus.Absent ? "bg-danger text-white"
                : string.Empty;
                var colorClass = item.ResearchDocumentScore?.IsApproved == StudentStatus.Rejected ? "btn btn-outline-light"
                : item.ResearchDocumentScore?.IsApproved == StudentStatus.Approved ? "btn btn-outline-light"
                : item.ResearchDocumentScore?.IsApproved == StudentStatus.Absent ? "btn btn-outline-light"
                : "btn btn-outline-dark";
                <tr id="tr_@(item.Id)" class="@rowClass">
                    <td>@i</td>
                    <td>
                        <img src="~/img/user.jpg" class="img-thumbnail rounded-circle"
                             style="width:50px; height:50px; object-fit:cover;"
                             alt="user photo" />
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                    <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                    <td>@Html.DisplayFor(modelItem => item.FatherName)</td>
                    <td>@Html.DisplayFor(modelItem => item.NationalCode)</td>
                    <td>@Html.DisplayFor(modelItem => item.ResearchDocumentScore.IsApproved)</td>
                    <td>@Html.DisplayFor(modelItem => item.ResearchDocumentScore.RejectReason)</td>
                    <td>@Html.DisplayFor(modelItem => item.ResearchDocumentScore.FinalTotalScore)</td>
                    <td>
                        <a class="@colorClass" onclick="Detail('@item.Id')" title="اطلاعات داوطلب"><i class="fa fa-info"></i></a>
                    </td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>


<script src="~/js/bootstrap-confirmation.min.js"></script>  <!-- For confirmed delete -->
<script src="~/admin/plugins/datatables/jquery.datatables.min.js"></script>
<script src="~/admin/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/admin/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>

<script type="text/javascript">
    $(function () {
        $('#tbl_exam').DataTable({
            paging: true,
            searching: true,
            lengthChange: true,
            ordering: true,
            info: true,
            autoWidth: false,
            buttons: ["copy", "csv", "excel", "pdf", "print", "colvis"]
        }).buttons().container().appendTo('#tbl_exam_wrapper .col-md-6:eq(0)');

    });
    function Detail(id) {
        openModal('جزئیات', '/DV/ResearchDocumentByUniv/Details?id=' + id, true);
    }
</script>