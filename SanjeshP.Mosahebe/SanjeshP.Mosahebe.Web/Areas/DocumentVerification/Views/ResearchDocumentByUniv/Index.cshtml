@model IEnumerable<SanjeshP.Mosahebe.Entities.Exam.Exams>


<div class="bg-light rounded p-4">
    <h3>لیست داوطلبان <span class="text-danger fw-bold">پژوهشی</span></h3>
    <div class="row mb-3">
        <div class="col-md-4">
            نام آزمون :
            <select id="examSelect" class="form-control">

                <option value="">-- یک آزمون انتخاب کنید --</option>
                @foreach (var exam in Model)
                {
                    <option value="@exam.Id">@exam.Title</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            نام رشته :
            <div id="fieldContainer">
                <select id="fieldSelect" class="form-control">
                    <option value="">-- ابتدا آزمون را انتخاب کنید --</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div id="StudentList"></div>
@section scripts {
    <script>
        $(document).ready(function () {
            $('#examSelect').change(function () {
                var examId = $(this).val();
                if (!examId) {
                    $('#fieldSelect').html('<option value="">-- ابتدا آزمون را انتخاب کنید --</option>');
                    return;
                }
                console.log * ('/DV/ResearchDocumentByUniv/FieldDropdown?examId=' + examId)
                // درخواست AJAX برای گرفتن رشته‌های آزمون
                $("#fieldContainer").load('/DV/ResearchDocumentByUniv/FieldDropdown?examId=' + examId);
            });

            // وقتی رشته انتخاب شد، لیست دانشجویان لود شود
            $(document).on('change', '#fieldSelect', function () {
                var fieldId = $(this).val();
                if (fieldId) {
                    $("#StudentList").load('/DV/ResearchDocumentByUniv/StudentsList?fieldId=' + fieldId);
                }
            });
        });
    </script>
}
