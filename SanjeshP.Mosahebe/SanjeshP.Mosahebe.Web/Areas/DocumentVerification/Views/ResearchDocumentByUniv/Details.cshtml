@using SanjeshP.Mosahebe.Entities.StudentForm
@using SanjeshP.Mosahebe.Web.Areas.DocumentVerification.ViewModels
@model StudentFormSubmissionViewModel

@{
    Layout = null;
    var forms = Model.Forms?.ToList() ?? new List<StudentFormSubmission>();
}

<style>
    .scoreItemContainer {
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.05);
    }

    .card-title {
        font-weight: 600;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    .invalid-feedback {
        color: #dc3545;
    }

    .shadow {
        transition: all 0.6s ease;
    }

        .shadow:hover {
            box-shadow: 0px 13px 22px rgb(0 0 0 / 62%) !important;
            transform: scale(1.03);
        }
</style>

<div class="card scoreItemContainer mb-3 border border-2">
    <div class="card-header card-title text-light text-center" style="background:radial-gradient(circle, #348780, #363e5f)">
        <strong class="h3">اطلاعات داوطلب</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="info mb-2 col-6">
                <span class="h5 text-bold">نام و نام خانوادگی : </span>
                <span class="h5 text-bold text-dark">@Model.StudentName</span>
            </div>
            <div class="info mb-2 col-6">
                <span class="h5 text-bold">کد ملی : </span>
                <span class="h5 text-bold text-dark">@Model.NationalCode</span>
            </div>
            <div class="info col-12">
                <span class="h5 text-bold">رشته : </span>
                <span class="h5 text-bold text-dark">@Model.FielsTitle</span>
            </div>
        </div>
    </div>
</div>

<form id="saveScoresForm" asp-action="SaveScores" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div class="container mt-2 pl-4 pr-4">
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-warning">
                @ViewBag.Message
            </div>
        }
        @foreach (var form in Model.Forms)
        {
            var datas = form.StudentFormSubmissionDatas?.ToList() ?? new List<StudentFormSubmissionData>();
            <div class="card scoreItemContainer shadow mb-3" data-id="@form.Id">
                <div class="card-header card-title bg-light">
                    <strong>@form.FormItem?.Title</strong>
                    <p class="text-info text-sm">@form.FormItem?.Description</p>
                </div>
                <div class="card-body" id="scoreItem_@form.Id">

                    <div class="row">
                        <div class="col-sm-6">
                            @for (int i = 0; i < form.StudentFormSubmissionDatas.Count; i++)
                            {
                                var field = form.StudentFormSubmissionDatas.ElementAt(i);
                                var oneMax = form.FormItem?.OneMaxScore ?? 0;
                                <div class="mb-2 field-line" data-idx="@i" data-one-max="@oneMax">
                                    <label class="me-1">@((field.FormItemDefinition?.Label) ?? (field.FormItemCoefficientDefinition?.Label) ?? "بدون عنوان")</label>:
                                    <span>
                                        @if (field.InputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.File)
                                        {
                                            <a class="btn btn-sm btn-outline-dark"
                                               asp-controller="EducationDocument"
                                               asp-action="DownloadSubmissionFile"
                                               asp-route-submissionDataId="@field.Id"
                                               asp-route-studentId="@form.StudentId"
                                               target="_blank" rel="noopener noreferrer">دانلود فایل</a>
                                            <a class="btn btn-sm btn-outline-primary" onclick="PreviewSubmissionFile('@form.FormItem.Title','@field.Id',@form.StudentId)" title="اطلاعات آزمون">مشاهده فایل</a>

                                        }
                                        else if (field.InputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.Checkbox)
                                        {
                                            <span>@(field.Value == "true" ? "بله" : "خیر")</span>
                                        }
                                        else
                                        {
                                            <span>@field.Value</span>
                                        }
                                    </span>

                                    <input type="hidden" name="Forms[@Model.Forms.ToList().IndexOf(form)].Datas[@i].SubmissionDataId" value="@field.Id" />
                                    <input type="hidden" name="Forms[@Model.Forms.ToList().IndexOf(form)].Datas[@i].FormItemDefinitionId" value="@field.FormItemDefinitionId" />
                                    <input type="hidden" name="Forms[@Model.Forms.ToList().IndexOf(form)].Datas[@i].FormItemCoefficientDefinitionId" value="@field.FormItemCoefficientDefinitionId" />
                                </div>
                            }
                        </div>
                    </div> <!-- /.row -->
                </div> <!-- /.card-body -->
            </div> <!-- /.card -->
        }
    </div>

    <div class="card mt-3">
        <div class="card-header card-title text-light text-center" style="background:radial-gradient(circle, #348780, #363e5f)">
            وارد کردن وضعیت داوطلب
        </div>

        <p class="alert alert-light fw-bold text-center h5">
            وضعیت داوطلب را مشخص کنید، سپس در صورت لزوم نمره یا دلیل عدم تأیید را وارد نمایید.
        </p>



        <div class="row mb-3 text-center pl-4 pr-4">
            <div class="col-md-4 p-2">
                <input type="radio" name="Status" id="statusAbsent" value="0" class="form-check-input me-1" />
                <label for="statusAbsent" class="form-check-label h6 text-secondary">وضعیت غایب</label>
            </div>
            <div class="col-md-4">
                <input type="radio" name="Status" id="statusRejected" value="1" class="form-check-input me-1" />
                <label for="statusRejected" class="form-check-label h6 text-danger">وضعیت عدم تأیید</label>
                <!-- دلیل رد -->
                <div id="rejectSection" class="mb-3">
                    <label for="RejectReason" class="form-label">دلیل عدم تأیید</label>
                    <textarea class="form-control" name="RejectReason" id="RejectReason" rows="1" placeholder="توضیح دلیل رد..." disabled></textarea>
                    <div class="invalid-feedback">دلیل رد را وارد کنید.</div>
                </div>
            </div>
            <div class="col-md-4">
                <input type="radio" name="Status" id="statusApproved" value="2" class="form-check-input me-1" />
                <label for="statusApproved" class="form-check-label h6 text-success">وضعیت تأیید</label>

                <!-- نمره نهایی -->
                <div id="scoreSection" class="mb-3">

                    <label for="FinalTotalScore" class="form-label">نمره نهایی (0 تا 100)</label>
                    <input type="number" step="0.01" min="0" max="100" class="form-control" id="FinalTotalScore" name="FinalTotalScore" placeholder="مثال: 85.25" disabled />
                    <div class="invalid-feedback">لطفاً عددی بین 0 تا 100 وارد کنید.</div>
                    <p class="alert alert-danger fw-bold text-center h4 mt-4">
                        منظور از نمره نهایی مجموع نمره مصاحبه و بررسی مدارک می‌باشد.
                    </p>
                </div>
            </div>
        </div>

        <input type="hidden" name="StudentId" id="StudentId" value="@Model.StudentId" />

        <div class="d-flex justify-content-center m-3">
            <button type="button" class="btn btn-success" id="btnSaveScore">
                <i class="fa fa-save me-1"></i> ذخیره اطلاعات
            </button>
        </div>

    </div>
</form>

<script>
    function PreviewSubmissionFile(title, id, StudentId) {
        openModal('مشاهده فایل ' + title, '/DV/ResearchDocumentByUniv/PreviewSubmissionFile?submissionDataId=' + id + '&studentId=' + StudentId, true);
    }
    $(document).ready(function () {

        const scoreSection = $("#scoreSection");
        const rejectSection = $("#rejectSection");
        const scoreInput = $("#FinalTotalScore");
        const reasonInput = $("#RejectReason");
        const btnSave = $("#btnSaveScore");

        // وقتی فرم باز می‌شود: همه‌چیز غیرفعال است
        scoreInput.prop("disabled", true).val('');
        reasonInput.prop("disabled", true).val('');

        $("input[name='Status']").on("change", function () {
            const value = parseInt($(this).val());

            if (value === 0) { // absent
                scoreInput.prop("disabled", true).val('');
                reasonInput.prop("disabled", true).val('');
            } else if (value === 1) { // rejected
                scoreInput.prop("disabled", true).val('');
                reasonInput.prop("disabled", false);
            } else if (value === 2) { // approved
                scoreInput.prop("disabled", false);
                reasonInput.prop("disabled", true).val('');
            }
        });


        // ذخیره اطلاعات
        btnSave.on("click", function () {
            let status = parseInt($("input[name='Status']:checked").val());
            let score = parseFloat(scoreInput.val());
            const reason = reasonInput.val().trim();
            const studentId = $("#StudentId").val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (isNaN(status)) {
                Toast.fire({ icon: 'warning', title: "لطفاً وضعیت داوطلب را انتخاب کنید." });
                return;
            }

            if (status !== 2) score = 0; // فقط در صورت تایید نمره اعمال شود

            if (status === 2 && (isNaN(score) || score < 0 || score > 100)) {
                scoreInput.addClass("is-invalid").focus();
                Toast.fire({ icon: 'error', title: "نمره باید عددی بین 0 تا 100 باشد." });
                return;
            }

            if (status === 1 && reason === "") {
                reasonInput.addClass("is-invalid").focus();
                Toast.fire({ icon: 'error', title: "دلیل عدم تأیید را وارد کنید." });
                return;
            }

            btnSave.prop("disabled", true).text("در حال ذخیره...");

            $.ajax({
                url: '/DV/ResearchDocumentByUniv/SaveResearchDocumentScore',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token,
                    StudentId: studentId,
                    Status: status,
                    FinalScore: score,
                    RejectReason: reason
                },
                success: function (response) {
                    if (response.isSuccess) {
                        Toast.fire({ icon: 'success', title: response.message || "ذخیره شد." });
                        // رفرش لیست داوطلبان پشت صفحه
                        const fieldId = $('#fieldSelect').val();
                        if (fieldId) {
                            $('#StudentList').load('/DV/ResearchDocumentByUniv/StudentsList?fieldId=' + encodeURIComponent(fieldId));
                        }
                    } else {
                        Toast.fire({ icon: 'warning', title: response.message || "ذخیره انجام نشد." });
                    }
                },
                error: function () {
                    Toast.fire({ icon: 'error', title: "خطا در ارتباط با سرور." });
                },
                complete: function () {
                    btnSave.prop("disabled", false).text("ذخیره اطلاعات");
                }
            });
        });

    });

</script>