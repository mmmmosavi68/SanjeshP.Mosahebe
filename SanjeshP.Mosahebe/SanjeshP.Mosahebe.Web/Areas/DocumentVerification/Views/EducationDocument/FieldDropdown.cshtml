@model IEnumerable<SanjeshP.Mosahebe.Entities.Exam.ExamField>

<select id="fieldSelect" class="form-control">
    <option value="">-- یک ایستگاه انتخاب کنید --</option>
    @foreach (var field in Model)
    {
        <option value="@field.Id">@field.Title</option>
    }
</select>


<script>
    $(document).ready(function () {
        // برای همه‌ی select ها به‌صورت خودکار
        $('select').select2({
            theme: 'bootstrap4',
            width: '100%', // تا اندازه‌ی کامل container رو بگیره
            placeholder: 'انتخاب کنید...',
            // allowClear: true
        });
    });
</script>