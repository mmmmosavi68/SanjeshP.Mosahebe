@using SanjeshP.Mosahebe.Entities.StudentForm
@using SanjeshP.Mosahebe.Web.Areas.DocumentVerification.ViewModels
@model StudentFormSubmissionViewModel

@{
    Layout = null;
    var forms = Model.Forms?.ToList() ?? new List<StudentFormSubmission>();
}

<style>
    .scoreItemContainer {
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.05);
    }

    .card-title {
        font-weight: 600;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    .invalid-feedback {
        color: #dc3545;
    }

    .shadow {
        transition: all 0.6s ease;
    }

        .shadow:hover {
            box-shadow: 0px 13px 22px rgb(0 0 0 / 62%) !important;
            transform: scale(1.03);
        }
</style>

<div class="card scoreItemContainer mb-3 border border-2">
    <div class="card-header card-title text-light text-center" style="background:radial-gradient(circle, #348780, #363e5f)">
        <strong class="h3">اطلاعات داوطلب</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="info mb-2 col-6">
                <span class="h5 text-bold">نام و نام خانوادگی : </span>
                <span class="h5 text-bold text-dark">@Model.StudentName</span>
            </div>
            <div class="info mb-2 col-6">
                <span class="h5 text-bold">کد ملی : </span>
                <span class="h5 text-bold text-dark">@Model.NationalCode</span>
            </div>
            <div class="info col-12">
                <span class="h5 text-bold">رشته : </span>
                <span class="h5 text-bold text-dark">@Model.FielsTitle</span>
            </div>
        </div>
    </div>
</div>

<form id="saveScoresForm" asp-action="SaveScores" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div class="container mt-2 pl-4 pr-4">
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-warning">
                @ViewBag.Message
            </div>
        }
        @foreach (var form in Model.Forms)
        {
            var datas = form.StudentFormSubmissionDatas?.ToList() ?? new List<StudentFormSubmissionData>();
            <div class="card scoreItemContainer shadow mb-3" data-id="@form.Id">
                <div class="card-header card-title bg-light">
                    <strong>@form.FormItem?.Title</strong>
                    <p class="text-danger text-sm">@form.FormItem?.Description</p>
                    <p class="text-danger fs-4 fw-bold">@form.FormItem?.PrivateDescription</p>
                </div>
                <div class="card-body" id="scoreItem_@form.Id">

                    <div class="row">
                        <div class="col-sm-6">
                            @for (int i = 0; i < form.StudentFormSubmissionDatas.Count; i++)
                            {
                                var field = form.StudentFormSubmissionDatas.ElementAt(i);
                                var oneMax = form.FormItem?.OneMaxScore ?? 0;
                                <div class="mb-2 field-line" data-idx="@i" data-one-max="@oneMax">
                                    <label class="me-1">@((field.FormItemDefinition?.Label) ?? (field.FormItemCoefficientDefinition?.Label) ?? "بدون عنوان")</label>:
                                    <span>
                                        @if (field.InputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.File)
                                        {
                                            <a class="btn btn-sm btn-outline-dark"
                                               asp-controller="EducationDocument"
                                               asp-action="DownloadSubmissionFile"
                                               asp-route-submissionDataId="@field.Id"
                                               asp-route-studentId="@form.StudentId"
                                               target="_blank" rel="noopener noreferrer">دانلود فایل</a>
                                            <a class="btn btn-sm btn-outline-primary" onclick="PreviewSubmissionFile('@form.FormItem.Title','@field.Id',@form.StudentId)" title="اطلاعات آزمون">مشاهده فایل</a>

                                        }
                                        else if (field.InputType == SanjeshP.Mosahebe.Entities.StudentForm.InputType.Checkbox)
                                        {
                                            <span>@(field.Value == "true" ? "بله" : "خیر")</span>
                                        }
                                        else
                                        {
                                            <span>@field.Value</span>
                                        }
                                    </span>

                                    <input type="hidden" name="Forms[@Model.Forms.ToList().IndexOf(form)].Datas[@i].SubmissionDataId" value="@field.Id" />
                                    <input type="hidden" name="Forms[@Model.Forms.ToList().IndexOf(form)].Datas[@i].FormItemDefinitionId" value="@field.FormItemDefinitionId" />
                                    <input type="hidden" name="Forms[@Model.Forms.ToList().IndexOf(form)].Datas[@i].FormItemCoefficientDefinitionId" value="@field.FormItemCoefficientDefinitionId" />
                                </div>
                            }
                        </div>
                        <div class="col-sm-6">
                            <div class="card shadow">
                                <div class="card-header bg-info">نتیجه _  @form.FormItem?.FormItemCoefficient?.Title  </div>
                                <div class="row card-body">
                                    <div class="col-6">
                                        <input type="hidden" name="Forms[@Model.Forms.ToList().IndexOf(form)].FormSubmissionScoreId" value="@form.Id" />
                                        <input type="hidden" name="Forms[@Model.Forms.ToList().IndexOf(form)].FormItemId" value="@form.FormItemId" />

                                        <input type="checkbox"
                                               id="notRejected_@form.Id"
                                               class="notRejected form-check-input"
                                               data-id="@form.Id"
                                               name="Forms[@Model.Forms.ToList().IndexOf(form)].IsApproved"
                                               value="true">
                                        <label for="notRejected_@form.Id" class="form-check-label">مدرک، مورد تایید است.</label>

                                        <input list="rejectedList_@form.Id"
                                               maxlength="1000"
                                               id="rejectReason_@form.Id"
                                               name="Forms[@Model.Forms.ToList().IndexOf(form)].RejectReason"
                                               type="text"
                                               class="rejectReason form-control mt-2"
                                               placeholder="علت عدم تایید"
                                               required>
                                        <datalist id="rejectedList_@form.Id">
                                            <option value="تکراری"></option>
                                            <option value="موقعیت اشتباه"></option>
                                            <option value="لیست سیاه"></option>
                                        </datalist>
                                    </div>
                                    @if (form.FormItem?.FormItemCoefficient?.CoefficientId == 3 || form.FormItem?.FormItemCoefficient?.CoefficientId == 5 || form.FormItem?.FormItemCoefficient?.CoefficientId == 2)
                                    {
                                        <div class="col-6">
                                            <label>امتیاز شما:</label>
                                            <input id="scoreValue_@form.Id"
                                                   name="Forms[@Model.Forms.ToList().IndexOf(form)].ScoreValue"
                                                   type="text"
                                                   class="scoreTextValue form-control"
                                                   placeholder="امتیاز خود را برای این مدرک وارد نمایید."
                                                   data-one-max="@form.FormItem?.OneMaxScore"
                                                   min="0"
                                                   max="@form.FormItem?.OneMaxScore"
                                                   disabled>
                                            <span class="form-text text-muted">
                                                حداکثر امتیاز: @form.FormItem?.OneMaxScore
                                            </span>
                                            <div class="invalid-feedback mt-1" id="scoreFeedback_@form.Id" style="display:none">
                                                لطفاً عددی بین 0 و @form.FormItem?.OneMaxScore وارد کنید.
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                    </div> <!-- /.row -->
                </div> <!-- /.card-body -->
            </div> <!-- /.card -->
        }
    </div>

    @if (ViewBag.Message == null)
    {
        <div class="container mb-5">
            <button type="submit" class="btn btn-success" id="saveScoresBtn">ذخیره نمرات</button>
        </div>
    }
</form>

<script src="~/js/bootstrap-confirmation.min.js"></script>
<script src="~/admin/plugins/datatables/jquery.datatables.min.js"></script>
<script src="~/admin/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/admin/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>

<script>

    function PreviewSubmissionFile(title,id, StudentId) {
        openModal('مشاهده فایل ' + title, '/DV/EducationDocument/PreviewSubmissionFile?submissionDataId=' + id + '&studentId=' + StudentId, true);
    }
    $(function () {

        // ===========================
        // توابع اعتبارسنجی و رفتار قبلی بدون تغییر
        // ===========================
        function validateScoreInput($input) {
            if (!$input || $input.length === 0) return true;

            var id = $input.attr('id') || '';
            var idx = id.replace('scoreValue_', '');
            var $feedback = $('#scoreFeedback_' + idx);

            if ($input.prop('disabled')) {
                $input.removeClass('is-invalid');
                if ($feedback.length) $feedback.hide();
                return true;
            }

            var val = $input.val();
            if (val === '' || isNaN(parseFloat(val))) {
                $input.addClass('is-invalid');
                if ($feedback.length) $feedback.text('لطفاً یک عدد معتبر وارد کنید.').show();
                return false;
            }

            var num = parseFloat(val);
            var min = parseFloat($input.attr('min') || '0');
            var maxAttr = parseFloat($input.attr('max') || '');
            var dataMax = parseFloat($input.data('one-max') || $input.data('oneMax') || '');
            var max = (!isNaN(maxAttr) && maxAttr > 0) ? maxAttr : (!isNaN(dataMax) ? dataMax : 0);

            if (num < min || (max > 0 && num > max)) {
                $input.addClass('is-invalid');
                if ($feedback.length) $feedback.text('مقدار باید بین ' + min + ' و ' + max + ' باشد.').show();
                return false;
            }

            $input.removeClass('is-invalid');
            if ($feedback.length) $feedback.hide();
            return true;
        }

        function toggleScoreByCheckbox(id, checked) {
            var $reject = $('#rejectReason_' + id);
            var $score = $('#scoreValue_' + id);
            var $feedback = $('#scoreFeedback_' + id);

            if (checked) {
                if ($reject.length) {
                    $reject.val('').prop('disabled', true).prop('required', false).removeClass('is-invalid');
                }
                if ($score.length) {
                    $score.prop('disabled', false).prop('required', true);
                    var dataOneMax = $score.data('oneMax') || $score.data('one-max');
                    if (!$score.attr('max') && dataOneMax) $score.attr('max', dataOneMax);
                    validateScoreInput($score);
                }
                if ($feedback.length) $feedback.hide();
            } else {
                if ($score.length) $score.prop('disabled', true).prop('required', false).val('').removeClass('is-invalid');
                if ($reject.length) $reject.prop('disabled', false).prop('required', true);
                if ($feedback.length) $feedback.hide();
            }
        }

        $(document).on('input', '.scoreTextValue', function () {
            var $this = $(this);
            var val = $this.val();
            var m = val.match(/^\d+(\.\d{0,2})?/);
            var newVal = m ? m[0] : '';
            if (newVal !== val) $this.val(newVal);

            validateScoreInput($this);
        });

        $('.notRejected').each(function () {
            var id = $(this).data('id');
            toggleScoreByCheckbox(id, $(this).prop('checked'));
        });

        $(document).on('change', '.notRejected', function () {
            var id = $(this).data('id');
            toggleScoreByCheckbox(id, $(this).prop('checked'));
        });

        // ===========================
        // اعتبارسنجی جامع قبل از ارسال (همانند نسخه قبلی)
        // این تابع تنها بررسی را انجام می‌دهد و نتیجه بولی برمی‌گرداند
        // ===========================
        function validateAll() {
            var ok = true;

            $('.scoreTextValue').each(function () {
                if (!validateScoreInput($(this))) ok = false;
            });

            $('.notRejected').each(function () {
                var id = $(this).data('id');
                var checked = $(this).prop('checked');

                if (checked) {
                    var $score = $('#scoreValue_' + id);
                    if ($score.length && ($score.val() === '' || $score.hasClass('is-invalid'))) {
                        ok = false;
                        $score.addClass('is-invalid');
                    }
                } else {
                    var $reject = $('#rejectReason_' + id);
                    if ($reject.length) {
                        var val = ($reject.val() || '').toString().trim();
                        if (val === '') {
                            ok = false;
                            $reject.addClass('is-invalid');

                            var $fb = $('#rejectFeedback_' + id);
                            if ($fb.length === 0) {
                                $fb = $('<div/>', {
                                    id: 'rejectFeedback_' + id,
                                    'class': 'invalid-feedback',
                                    text: 'لطفاً دلیل رد را وارد یا از لیست انتخاب کنید.'
                                });
                                $reject.after($fb);
                            }
                            $fb.show();
                        } else {
                            $reject.removeClass('is-invalid');
                            $('#rejectFeedback_' + id).hide();
                        }
                    }
                }
            });

            if (!ok) {
                var $first = $('.is-invalid').first();
                if ($first.length) $('html, body').animate({ scrollTop: $first.offset().top - 100 }, 300);
            }

            return ok;
        }

        // ===========================
        // AJAX submit: ارسال فرم به صورت AJAX و فقط رفرش StudentList
        // ===========================
        $('#saveScoresForm').on('submit', function (e) {
            e.preventDefault();

            if (!validateAll()) {
                alert('لطفاً خطاهای فرم را اصلاح کنید.');
                return;
            }

            var $form = $(this);
            var $btn = $('#saveScoresBtn');
            var oldText = $btn.text();
            $btn.prop('disabled', true).text('در حال ذخیره...');

            // اگر از antiforgery استفاده می‌کنید، توکن در فرم وجود دارد و serialize آن را شامل می‌شود
            var data = $form.serialize();

            $.ajax({
                url: $form.attr('action') || '/DV/EducationDocument/SaveScores',
                method: 'POST',
                data: data,
                success: function (response) {
                    // اگر کنترلر Ok با JSON برمی‌گرداند می‌توانید چک کنید response.success
                    // اما ساده‌ترین حالت: اگر موفقیت آمیز باشد، لیست دانشجویان مجدداً لود شود

                    var fieldId = $('#fieldSelect').val();
                    if (fieldId) {
                        $('#StudentList').load('/DV/EducationDocument/StudentsList?fieldId=' + encodeURIComponent(fieldId));
                    } else {
                        $('#StudentList').html('');
                    }

                    // اگر فرم داخل مودال باز شده بود، آن را ببندید
                    // فرض: از openModal استفاده می‌کنید که modal را باز کرده؛ اگر modal bootstrap دارید:
                    $('.modal').modal('hide');
                },
                error: function (xhr) {
                    // در صورت بازگشت JSON حاوی پیام خطا، می‌توانید آن را نمایش دهید
                    alert('خطا در ذخیره نمرات. لطفاً دوباره تلاش کنید.');
                },
                complete: function () {
                    $btn.prop('disabled', false).text(oldText);
                }
            });
        });

        // ===========================
        // اگر نیاز به init دیتاتِیبِل یا اسکریپت‌های دیگر پس از لود partial دارید،
        // آنها را اینجا اضافه کنید یا در Partial مربوطه قرار دهید.
        // ===========================

    });
</script>
