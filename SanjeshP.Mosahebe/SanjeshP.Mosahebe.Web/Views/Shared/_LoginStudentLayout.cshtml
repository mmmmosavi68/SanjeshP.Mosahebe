<!DOCTYPE html>
<html lang="en">
<head>
	<title>Login V1</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<!--===============================================================================================-->
	<link rel="icon" type="image/png" href="~/studentlogin/images/icons/favicon.ico" />
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/studentlogin/vendor/bootstrap/css/bootstrap.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/studentlogin/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/studentlogin/vendor/animate/animate.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/studentlogin/vendor/css-hamburgers/hamburgers.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/studentlogin/vendor/select2/select2.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/studentlogin/css/util.css">
	<link rel="stylesheet" type="text/css" href="~/studentlogin/css/main.css">
	<!--===============================================================================================-->
	@await RenderSectionAsync("style", required: false)
</head>
<body>

	<div class="limiter">
		<div class="container-login100">
			<div class="wrap-login100">
				<div class="login100-pic js-tilt" data-tilt>
					<img src="~/studentlogin/images/img-01.png" alt="IMG">
				</div>
				<div>
					@RenderBody()
				</div>
			</div>
		</div>
	</div>
	<!--===============================================================================================-->
	<script src="~/studentlogin/vendor/jquery/jquery-3.2.1.min.js"></script>
	<!--===============================================================================================-->
	<script src="~/studentlogin/vendor/bootstrap/js/popper.js"></script>
	<script src="~/studentlogin/vendor/bootstrap/js/bootstrap.min.js"></script>
	<!--===============================================================================================-->
	<script src="~/studentlogin/vendor/select2/select2.min.js"></script>
	<!--===============================================================================================-->
	<script src="~/studentlogin/vendor/tilt/tilt.jquery.min.js"></script>
	<script>
		$('.js-tilt').tilt({
			scale: 1.1
		})
	</script>
	<!--===============================================================================================-->
	<script src="~/studentlogin/js/main.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
